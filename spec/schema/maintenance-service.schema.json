{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/maintenance-service-v1.json",
  "title": "Maintenance Service Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "service",
    "entity",
    "validations",
    "businessRules",
    "sideEffects",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "service": { "$ref": "#/$defs/service" },
    "entity": { "$ref": "#/$defs/entity" },
    "validations": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation" }
    },
    "businessRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/businessRule" }
    },
    "sideEffects": {
      "type": "array",
      "items": { "$ref": "#/$defs/sideEffect" }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "route", "operation", "failureMode"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "route": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["bulkInsert", "bulkUpsert"] },
        "failureMode": { "enum": ["atomicBatch", "partialBatch"] }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key", "properties"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "key": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/property" }
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "minimumLength": { "type": "integer", "minimum": 0 },
        "maximumLength": { "type": "integer", "minimum": 1 },
        "allowedValues": {
          "type": "array",
          "items": { "type": ["string", "number", "integer", "boolean", "null"] }
        }
      }
    },
    "validation": {
      "oneOf": [
        { "$ref": "#/$defs/requiredValidation" },
        { "$ref": "#/$defs/maximumLengthValidation" },
        { "$ref": "#/$defs/comparisonValidation" },
        { "$ref": "#/$defs/prohibitedTransitionValidation" },
        { "$ref": "#/$defs/conditionalRequiredValidation" },
        { "$ref": "#/$defs/batchUniqueValidation" },
        { "$ref": "#/$defs/customRuleValidation" }
      ]
    },
    "validationBase": {
      "type": "object",
      "required": ["id", "type", "error"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "type": "string" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "requiredValidation": {
      "allOf": [
        { "$ref": "#/$defs/validationBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "property", "error"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "type": { "const": "required" },
            "property": { "$ref": "#/$defs/identifier" },
            "error": { "$ref": "#/$defs/error" }
          }
        }
      ]
    },
    "maximumLengthValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "property", "value", "error"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "maximumLength" },
        "property": { "$ref": "#/$defs/identifier" },
        "value": { "type": "integer", "minimum": 1 },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "comparisonValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "left", "operator", "right", "error"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "comparison" },
        "left": { "$ref": "#/$defs/valueSource" },
        "operator": { "enum": ["equal", "notEqual", "lessThan", "lessThanOrEqual", "greaterThan", "greaterThanOrEqual"] },
        "right": { "$ref": "#/$defs/valueSource" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "prohibitedTransitionValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "property", "from", "to", "error"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "prohibitedTransition" },
        "property": { "$ref": "#/$defs/identifier" },
        "from": {},
        "to": {},
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "conditionalRequiredValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "property", "when", "error"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "conditionalRequired" },
        "property": { "$ref": "#/$defs/identifier" },
        "when": { "$ref": "#/$defs/condition" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "batchUniqueValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "properties", "error"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "batchUnique" },
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "customRuleValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "requirements", "inputs", "outputs", "scenarioIds", "error"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "customRule" },
        "requirements": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "outputs": { "type": "array", "items": { "enum": ["validationFailure", "mutation", "sideEffect"] }, "minItems": 1 },
        "scenarioIds": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "minItems": 1 },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "businessRule": {
      "oneOf": [
        { "$ref": "#/$defs/setDefaultRule" },
        { "$ref": "#/$defs/setDerivedValueRule" }
      ]
    },
    "setDefaultRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "targetProperty", "when", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "setDefault" },
        "targetProperty": { "$ref": "#/$defs/identifier" },
        "when": { "$ref": "#/$defs/condition" },
        "value": { "$ref": "#/$defs/valueSource" }
      }
    },
    "setDerivedValueRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "targetProperty", "when", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "setDerivedValue" },
        "targetProperty": { "$ref": "#/$defs/identifier" },
        "when": { "$ref": "#/$defs/condition" },
        "value": { "$ref": "#/$defs/valueSource" }
      }
    },
    "sideEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "outputType", "when", "transactionMode", "idempotency", "mappings"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "produceEntity" },
        "outputType": { "$ref": "#/$defs/identifier" },
        "when": { "$ref": "#/$defs/condition" },
        "transactionMode": { "enum": ["sameTransaction", "outbox"] },
        "idempotency": { "$ref": "#/$defs/idempotency" },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mapping" }
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetProperty", "value"],
      "properties": {
        "targetProperty": { "$ref": "#/$defs/identifier" },
        "value": { "$ref": "#/$defs/valueSource" }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "values"],
      "properties": {
        "type": { "const": "composite" },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/valueSource" }
        }
      }
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/allCondition" },
        { "$ref": "#/$defs/propertyEqualsCondition" },
        { "$ref": "#/$defs/propertyTransitionCondition" },
        { "$ref": "#/$defs/isNewEntityCondition" }
      ]
    },
    "allCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "conditions"],
      "properties": {
        "type": { "const": "all" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" }
        }
      }
    },
    "propertyEqualsCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scope", "property", "value"],
      "properties": {
        "type": { "const": "propertyEquals" },
        "scope": { "enum": ["incoming", "existing", "result"] },
        "property": { "$ref": "#/$defs/identifier" },
        "value": {}
      }
    },
    "propertyTransitionCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "property", "from", "to"],
      "properties": {
        "type": { "const": "propertyTransition" },
        "property": { "$ref": "#/$defs/identifier" },
        "from": {},
        "to": {}
      }
    },
    "isNewEntityCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "isNewEntity" }
      }
    },
    "valueSource": {
      "oneOf": [
        { "$ref": "#/$defs/constantValue" },
        { "$ref": "#/$defs/propertyValue" },
        { "$ref": "#/$defs/contextValue" }
      ]
    },
    "constantValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "value"],
      "properties": {
        "source": { "const": "constant" },
        "value": {}
      }
    },
    "propertyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "property"],
      "properties": {
        "source": { "enum": ["incomingProperty", "existingProperty", "resultProperty"] },
        "property": { "$ref": "#/$defs/identifier" }
      }
    },
    "contextValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "name"],
      "properties": {
        "source": { "const": "contextValue" },
        "name": { "$ref": "#/$defs/identifier" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "properties"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "message": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "title", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "given": { "type": "object" },
        "input": { "type": "object" },
        "inputBatch": { "type": "array", "items": { "type": "object" } },
        "expect": { "type": "object" }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["input"] },
        { "required": ["inputBatch"] }
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
      "minLength": 1
    }
  }
}
